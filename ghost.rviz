Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: simulation_reference
    Background Color: 30; 35; 45
    Frame Rate: 10
  Displays:
  - Class: rviz_default_plugins/RobotModel
    Name: Floating ghost
    Enabled: true
    Alpha: 1
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
    Visual Enabled: true
    Collision Enabled: false
  - Class: rviz_default_plugins/MarkerArray
    Name: Room geometry (known)
    Enabled: true
    Topic:
      Value: /simulation/reference_scene
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/PointCloud2
    Name: RGB-D cloud
    Enabled: false
    Topic:
      Value: /camera/points
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 2
    Color Transformer: RGB8
    Position Transformer: XYZ
    Style: Points
    Size (Pixels): 2
    Decay Time: 0
  - Class: rviz_default_plugins/Image
    Name: RGB camera
    Enabled: true
    Topic:
      Value: /camera/image
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 2
  - Class: rviz_default_plugins/Image
    Name: Depth camera
    Enabled: true
    Topic:
      Value: /camera/depth_image
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 2
    Normalize Range: false
    Min Value: 0
    Max Value: 8
  - Class: rviz_default_plugins/MarkerArray
    Name: Flyable space - height slice
    Enabled: true
    Topic:
      Value: /ghost/map/free_slice
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/MarkerArray
    Name: Obstacle voxels (full room)
    Enabled: false
    Topic:
      Value: /ghost/map/obstacles
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/MarkerArray
    Name: Ghost clearance exclusion
    Enabled: false
    Topic:
      Value: /ghost/map/clearance
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/MarkerArray
    Name: Flyable voxels (all heights)
    Enabled: false
    Topic:
      Value: /ghost/map/free_volume
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Path
    Name: 3D flight route
    Enabled: true
    Topic:
      Value: /ghost/path
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
    Color: 255; 80; 210
    Line Style: Billboards
    Line Width: 0.035
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Pitch: 0.65
      Yaw: 0.65
      Focal Point:
        X: 0
        Y: 0
        Z: 1.0
Window Geometry:
  Width: 1200
  Height: 760
